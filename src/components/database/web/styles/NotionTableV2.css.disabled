/**
 * Notion 風格資料庫表格樣式 V2
 * 完全重寫以匹配真實的 Notion 界面
 */

/* 根容器背景 */
body {
  background-color: #fbfbfa !important;
}

/* 主容器 - 包含整個資料庫 */
.notion-database-wrapper {
  width: 100%;
  min-height: 100vh;
  background-color: #fbfbfa;
  padding: 96px 96px 30px 96px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, "Apple Color Emoji", Arial, sans-serif, "Segoe UI Emoji", "Segoe UI Symbol";
  font-size: 14px;
  line-height: 1.5;
  color: #37352f;
}

@media (max-width: 768px) {
  .notion-database-wrapper {
    padding: 24px 24px 30px 24px;
  }
}

/* 內容容器 */
.notion-database-container {
  max-width: 100%;
  margin: 0 auto;
}

/* 工具列區域 */
.notion-database-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  height: 32px;
}

.notion-toolbar-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.notion-toolbar-right {
  display: flex;
  align-items: center;
  gap: 4px;
}

/* 視圖信息文字 */
.notion-view-info {
  font-size: 12px;
  color: #787774;
  padding: 0 8px;
}

/* 通用按鈕樣式 */
.notion-button {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  height: 28px;
  border: none;
  border-radius: 6px;
  background-color: transparent;
  color: rgba(55, 53, 47, 0.65);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.2;
  cursor: pointer;
  transition: background-color 20ms ease-in 0s;
  white-space: nowrap;
  user-select: none;
}

.notion-button:hover {
  background-color: rgba(55, 53, 47, 0.08);
  color: #37352f;
}

.notion-button:active {
  background-color: rgba(55, 53, 47, 0.16);
}

/* 主要按鈕（藍色） */
.notion-button-primary {
  background-color: #2383e2;
  border: none;
  color: #ffffff;
  border-radius: 6px;
}

.notion-button-primary:hover {
  background-color: #0369d9;
  color: #ffffff;
}

.notion-button-primary:active {
  background-color: #0860ca;
}

/* 表格本體 */
.notion-database-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  background-color: #ffffff;
  border: 1px solid rgba(55, 53, 47, 0.04);
  border-radius: 3px;
  overflow: hidden;
}

/* 表頭行 */
.notion-header-row {
  background-color: #ffffff;
}

/* 表頭單元格 */
.notion-header-cell {
  height: 32px;
  padding: 0;
  text-align: left;
  vertical-align: middle;
  border-bottom: 1px solid rgba(55, 53, 47, 0.04);
  border-right: 1px solid rgba(55, 53, 47, 0.04);
  background-color: #ffffff;
  position: relative;
  min-width: 120px;
  user-select: none;
}

.notion-header-cell:last-child {
  border-right: none;
}

.notion-header-cell:hover {
  background-color: rgba(55, 53, 47, 0.04);
}

/* 表頭內容容器 */
.notion-header-content {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  height: 100%;
  position: relative;
}

/* 屬性圖標 */
.notion-property-icon {
  font-size: 14px;
  color: rgba(55, 53, 47, 0.45);
  flex-shrink: 0;
  width: 18px;
  text-align: center;
}

/* 屬性名稱 */
.notion-property-name {
  font-size: 14px;
  font-weight: 400;
  color: rgba(55, 53, 47, 0.65);
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

/* 表頭操作按鈕（三點） */
.notion-header-actions {
  position: absolute;
  right: 4px;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0;
  transition: opacity 100ms ease-in-out;
}

.notion-header-cell:hover .notion-header-actions {
  opacity: 1;
}

.notion-header-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  padding: 0;
  background: none;
  border: none;
  border-radius: 3px;
  color: rgba(55, 53, 47, 0.45);
  cursor: pointer;
  font-size: 14px;
}

.notion-header-action-btn:hover {
  background-color: rgba(55, 53, 47, 0.08);
  color: rgba(55, 53, 47, 0.65);
}

/* 新增欄位按鈕 */
.notion-add-column-cell {
  width: 40px;
  min-width: 40px;
  padding: 0;
  border-bottom: 1px solid rgba(55, 53, 47, 0.04);
  border-right: none;
  background-color: #ffffff;
}

.notion-add-column-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: none;
  border: none;
  color: rgba(55, 53, 47, 0.35);
  cursor: pointer;
  font-size: 16px;
  transition: all 100ms ease-in-out;
}

.notion-add-column-btn:hover {
  background-color: rgba(55, 53, 47, 0.04);
  color: rgba(55, 53, 47, 0.65);
}

/* 資料行 */
.notion-data-row {
  background-color: #ffffff;
  transition: background-color 20ms ease-in 0s;
  cursor: default;
}

.notion-data-row:hover {
  background-color: rgba(55, 53, 47, 0.03);
}

.notion-data-row.selected {
  background-color: rgba(35, 131, 226, 0.12);
}

/* 資料單元格 */
.notion-cell {
  height: 32px;
  padding: 0;
  vertical-align: middle;
  border-bottom: 1px solid rgba(55, 53, 47, 0.04);
  border-right: 1px solid rgba(55, 53, 47, 0.04);
  position: relative;
  background-color: transparent;
}

.notion-cell:last-child {
  border-right: none;
}

.notion-data-row:last-child .notion-cell {
  border-bottom: none;
}

/* 單元格內容 */
.notion-cell-content {
  display: flex;
  align-items: center;
  padding: 4px 8px;
  min-height: 32px;
  font-size: 14px;
  color: #37352f;
  line-height: 1.2;
  cursor: text;
  position: relative;
}

.notion-cell-content:hover {
  background-color: rgba(55, 53, 47, 0.03);
}

/* 編輯中的單元格 */
.notion-cell-editing .notion-cell-content {
  background-color: #ffffff;
  box-shadow: 0 0 0 2px #2383e2;
  border-radius: 2px;
  z-index: 10;
}

/* 單元格占位符文字 */
.notion-cell-placeholder {
  color: rgba(55, 53, 47, 0.35);
  font-style: normal;
}

/* 空欄（對應新增欄位按鈕） */
.notion-cell-empty-column {
  width: 40px;
  min-width: 40px;
  padding: 0;
  border-bottom: 1px solid rgba(55, 53, 47, 0.04);
  border-right: none;
}

/* 狀態標籤 */
.notion-status-tag {
  display: inline-flex;
  align-items: center;
  padding: 0 6px;
  height: 20px;
  border-radius: 3px;
  font-size: 12px;
  font-weight: 400;
  white-space: nowrap;
  line-height: 1;
}

.notion-status-tag.completed {
  background-color: #d4e9dc;
  color: #326d51;
}

.notion-status-tag.in-progress {
  background-color: #d3e5f3;
  color: #28507f;
}

.notion-status-tag.todo {
  background-color: #fdecc8;
  color: #9f6b00;
}

/* 核取方塊 */
.notion-checkbox {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(55, 53, 47, 0.35);
  border-radius: 2px;
  background-color: transparent;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  position: relative;
  flex-shrink: 0;
  transition: all 100ms ease-in-out;
}

.notion-checkbox:hover {
  border-color: rgba(55, 53, 47, 0.65);
}

.notion-checkbox:checked {
  background-color: #2383e2;
  border-color: #2383e2;
}

.notion-checkbox:checked::after {
  content: '';
  position: absolute;
  top: 1px;
  left: 4px;
  width: 4px;
  height: 8px;
  border: solid white;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

/* 新增行區域 */
.notion-add-row {
  background-color: #ffffff;
}

.notion-add-row-cell {
  height: 32px;
  padding: 0;
  border: none;
}

.notion-add-row-button {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 100%;
  height: 100%;
  padding: 0 8px;
  background: none;
  border: none;
  color: rgba(55, 53, 47, 0.35);
  font-size: 14px;
  font-weight: 400;
  text-align: left;
  cursor: pointer;
  transition: all 100ms ease-in-out;
}

.notion-add-row-button:hover {
  background-color: rgba(55, 53, 47, 0.03);
  color: rgba(55, 53, 47, 0.65);
}

.notion-add-icon {
  font-size: 16px;
  line-height: 1;
}

/* 空狀態 */
.notion-empty-row {
  background-color: #ffffff;
}

.notion-empty-cell {
  height: 200px;
  padding: 0;
  border: none;
  text-align: center;
  vertical-align: middle;
}

.notion-empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 40px 20px;
}

.notion-empty-icon {
  font-size: 48px;
  opacity: 0.15;
  line-height: 1;
}

.notion-empty-text {
  font-size: 14px;
  color: rgba(55, 53, 47, 0.45);
  line-height: 1.2;
}

/* 滾動條樣式 */
.notion-database-wrapper::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

.notion-database-wrapper::-webkit-scrollbar-track {
  background: transparent;
}

.notion-database-wrapper::-webkit-scrollbar-thumb {
  background: rgba(55, 53, 47, 0.2);
  border-radius: 10px;
  background-clip: padding-box;
  border: 2px solid transparent;
}

.notion-database-wrapper::-webkit-scrollbar-thumb:hover {
  background: rgba(55, 53, 47, 0.3);
  background-clip: padding-box;
}

/* 工具提示 */
.notion-tooltip {
  position: absolute;
  background-color: rgba(15, 15, 15, 0.9);
  color: #ffffff;
  padding: 4px 8px;
  border-radius: 3px;
  font-size: 12px;
  white-space: nowrap;
  z-index: 1000;
  pointer-events: none;
}

/* 特定欄位寬度 */
.notion-header-cell[data-column="title"],
.notion-cell[data-column="title"] {
  min-width: 280px;
}

.notion-header-cell[data-column="status"],
.notion-cell[data-column="status"] {
  min-width: 120px;
}

.notion-header-cell[data-column="date"],
.notion-cell[data-column="date"] {
  min-width: 140px;
}

.notion-header-cell[data-column="checkbox"],
.notion-cell[data-column="checkbox"] {
  width: 48px;
  min-width: 48px;
  text-align: center;
}

.notion-header-cell[data-column="checkbox"] .notion-header-content,
.notion-cell[data-column="checkbox"] .notion-cell-content {
  justify-content: center;
}
{
  "name": "donnaai-functions",
  "version": "1.0.0",
  "description": "DonnaAI Cloud Functions",
  "main": "lib/index.js",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",

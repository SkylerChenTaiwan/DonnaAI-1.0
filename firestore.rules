rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 輔助函數：檢查是否為 Super Admin
    function isSuperAdmin() {
      return request.auth != null && (
        // 先檢查 token 中的資訊（不需要額外讀取）
        request.auth.token.role == 'system-admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'admin@donnaai-app.com' ||
        // 再檢查資料庫（使用 exists 避免權限錯誤）
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'system-admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true))
      );
    }
    
    // 輔助函數：安全獲取用戶資料
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }
    
    // 輔助函數：檢查用戶文檔是否存在
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // 輔助函數：檢查是否為組織管理員
    function isOrgAdmin(orgId) {
      return request.auth != null && 
        hasUserDoc() &&
        getUserData().organizationId == orgId && 
        getUserData().role == 'admin';
    }
    
    // 輔助函數：檢查是否為組織成員
    function isOrgMember(orgId) {
      return request.auth != null && 
        hasUserDoc() &&
        getUserData().organizationId == orgId;
    }
    
    // 組織集合
    match /organizations/{orgId} {
      // Super Admin 可以讀寫所有組織
      allow read, write: if isSuperAdmin();
      // 用戶可以建立組織（初次註冊時）
      allow create: if request.auth != null && 
        request.resource.data.adminUserId == request.auth.uid;
      // 組織成員可以讀取自己的組織
      allow read: if isOrgMember(orgId);
      // 組織管理員可以更新組織
      allow update: if isOrgAdmin(orgId);
    }
    
    // 用戶集合
    match /users/{userId} {
      // 用戶可以讀取自己的資料
      allow read: if request.auth != null && request.auth.uid == userId;
      // 用戶可以建立自己的資料（初次註冊）
      allow create: if request.auth != null && request.auth.uid == userId;
      // Super Admin 可以讀寫所有用戶
      allow read, write: if isSuperAdmin();
      // 組織管理員可以讀取同組織的用戶
      allow read: if request.auth != null && 
        hasUserDoc() &&
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
      // 組織管理員可以更新同組織的用戶（除了 role）
      allow update: if request.auth != null && 
        hasUserDoc() &&
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      // 用戶可以更新自己的基本資料（不包括敏感欄位）
      allow update: if request.auth != null && 
        request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organizationId', 'isSuperAdmin']));
    }
    
    // 團隊集合
    match /teams/{teamId} {
      // Super Admin 可以讀寫所有團隊
      allow read, write: if isSuperAdmin();
      // 組織成員可以讀取自己組織的團隊（支援 where 查詢）
      allow read: if request.auth != null && 
        getUserData().organizationId == resource.data.organizationId;
      // 團隊成員可以讀取（保留原有邏輯）
      allow read: if request.auth != null && 
        resource.data.memberIds != null &&
        request.auth.uid in resource.data.memberIds;
      // 組織管理員可以寫入組織內的團隊
      allow write: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 組織內客戶集合
    match /organizations/{orgId}/customers/{customerId} {
      // Super Admin 可以讀寫所有客戶（包括刪除）
      allow read, write, delete: if isSuperAdmin();
      // 組織管理員可以管理組織內的所有客戶
      allow read, write, delete: if isOrgAdmin(orgId);
      // 組織成員可以讀寫組織內的客戶
      allow read, write: if isOrgMember(orgId);
      // 創建者可以讀寫自己建立的客戶
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
      // 團隊成員可以讀寫相關客戶
      allow read, write: if request.auth != null && 
        resource.data.teamMembers != null &&
        request.auth.uid in resource.data.teamMembers;
    }
    
    // 舊版客戶集合（向下相容）
    match /customers/{customerId} {
      // Super Admin 可以讀寫刪除（用於系統管理和統計）
      allow read, write, delete: if isSuperAdmin();
      // 組織管理員可以刪除（用於清理重複資料）
      allow delete: if request.auth != null && 
        hasUserDoc() &&
        getUserData().role == 'admin';
      // 團隊成員可以讀寫
      allow read, write: if request.auth != null && 
        resource.data.teamMembers != null &&
        request.auth.uid in resource.data.teamMembers;
      // 創建者可以讀寫刪除
      allow read, write, delete: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
      // 新增客戶
      allow create: if request.auth != null;
    }
    
    // 組織內紀錄集合
    match /organizations/{orgId}/records/{recordId} {
      // Super Admin 可以讀寫所有紀錄（包括刪除）
      allow read, write, delete: if isSuperAdmin();
      // 組織管理員可以管理組織內的所有紀錄
      allow read, write, delete: if isOrgAdmin(orgId);
      // 組織成員可以讀寫組織內的紀錄
      allow read, write: if isOrgMember(orgId);
      // 創建者可以讀寫自己建立的紀錄
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
      // 團隊成員可以讀取相關紀錄
      allow read: if request.auth != null && 
        resource.data.teamMembers != null &&
        request.auth.uid in resource.data.teamMembers;
    }
    
    // 舊版紀錄集合（向下相容）
    match /records/{recordId} {
      // Super Admin 可以讀寫刪除（用於系統監控）
      allow read, write, delete: if isSuperAdmin();
      // 組織管理員可以刪除（用於清理）
      allow delete: if request.auth != null && 
        hasUserDoc() &&
        getUserData().role == 'admin';
      // 創建者可以讀寫
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
      // 團隊成員可以讀取
      allow read: if request.auth != null && 
        resource.data.teamMembers != null &&
        request.auth.uid in resource.data.teamMembers;
      // 新增紀錄
      allow create: if request.auth != null;
    }
    
    // 組織內任務集合
    match /organizations/{orgId}/tasks/{taskId} {
      // Super Admin 可以讀寫所有任務（包括刪除）
      allow read, write, delete: if isSuperAdmin();
      // 組織管理員可以管理組織內的所有任務
      allow read, write, delete: if isOrgAdmin(orgId);
      // 組織成員可以讀寫組織內的任務
      allow read, write: if isOrgMember(orgId);
      // 指派對象可以讀寫被指派的任務
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.assignedTo;
      // 創建者可以讀寫自己建立的任務
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
    }
    
    // 舊版任務集合（向下相容）
    match /tasks/{taskId} {
      // Super Admin 可以讀寫刪除（用於系統監控）
      allow read, write, delete: if isSuperAdmin();
      // 組織管理員可以刪除（用於清理）
      allow delete: if request.auth != null && 
        hasUserDoc() &&
        getUserData().role == 'admin';
      // 指派對象可以讀寫
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.assignedTo;
      // 創建者可以讀寫
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
      // 新增任務
      allow create: if request.auth != null;
    }
    
    // 設定集合 - 用戶個人設定
    match /users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == userId || isSuperAdmin());
    }
    
    // 組織設定集合
    match /organizations/{orgId}/settings/{settingId} {
      allow read: if isOrgMember(orgId) || isSuperAdmin();
      allow write: if isOrgAdmin(orgId) || isSuperAdmin();
    }
    
    // 組織管理員權限集合
    match /organizations/{orgId}/admin_permissions/{userId} {
      // Super Admin 可以讀寫所有權限
      allow read, write: if isSuperAdmin();
      // 組織管理員可以讀取權限
      allow read: if request.auth != null && 
        (request.auth.uid == userId || isOrgAdmin(orgId));
      // 組織管理員可以管理權限（但不能修改自己的權限）
      allow write: if request.auth != null && 
        isOrgAdmin(orgId) && 
        userId != request.auth.uid;
    }
    
    // AI 處理相關集合
    match /aiProcessing/{docId} {
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      allow read: if isSuperAdmin();
    }
    
    // 自定義欄位定義
    match /organizations/{orgId}/customFields/{fieldId} {
      allow read: if isOrgMember(orgId) || isSuperAdmin();
      allow write: if isOrgAdmin(orgId) || isSuperAdmin();
    }
    
    // 企業配置集合
    match /enterprise_configs/{configId} {
      // Super Admin 可以讀寫所有配置
      allow read, write: if isSuperAdmin();
      // 組織管理員可以讀取和更新自己組織的配置
      allow read: if request.auth != null && 
        getUserData().organizationId == resource.data.organizationId;
      allow update: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 系統統計（只有 Super Admin 可以存取）
    match /systemStats/{statId} {
      allow read: if isSuperAdmin();
      allow write: if false; // 只由 Cloud Functions 寫入
    }
    
    // 計費記錄集合
    match /billingRecords/{recordId} {
      // Super Admin 可以讀寫所有計費記錄
      allow read, write: if isSuperAdmin();
      // 組織管理員可以讀取和查詢計費記錄
      allow read: if request.auth != null && 
        getUserData().role == 'admin';
      // 組織成員可以讀取計費記錄（需要在查詢中限制 organizationId）
      allow read: if request.auth != null;
    }
    
    // 工具使用記錄集合
    match /tool_usage/{usageId} {
      // Super Admin 可以讀取所有使用記錄（用於系統分析）
      allow read: if isSuperAdmin();
      // 用戶可以建立自己的使用記錄
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      // 組織管理員可以讀取和查詢使用記錄
      allow read: if request.auth != null && 
        getUserData().role == 'admin';
      // 一般用戶可以讀取記錄（需要在查詢中限制）
      allow read: if request.auth != null;
    }
    
    // 工具使用每日統計集合
    match /tool_usage_daily_stats/{statId} {
      // Super Admin 可以讀寫所有統計
      allow read, write: if isSuperAdmin();
      // 系統可以建立和更新統計（由 Cloud Functions 或使用 service account）
      allow create, update: if request.auth != null;
      // 組織管理員可以讀取統計
      allow read: if request.auth != null && 
        getUserData().role == 'admin';
      // 一般用戶可以讀取統計（需要在查詢中限制）
      allow read: if request.auth != null;
    }
    
    // 自訂欄位配置集合
    match /custom_field_configs/{configId} {
      // Super Admin 可以讀寫所有配置
      allow read, write: if isSuperAdmin();
      // 組織管理員可以管理自己組織的配置
      allow read, write: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
      // 組織成員可以讀取自己組織的配置
      allow read: if request.auth != null && 
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 資料匯入日誌集合
    match /import_logs/{logId} {
      // Super Admin 可以讀取所有日誌
      allow read: if isSuperAdmin();
      // 系統可以建立日誌
      allow create: if request.auth != null;
      // 組織管理員可以讀取自己組織的日誌
      allow read: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 自訂欄位日誌集合
    match /custom_field_logs/{logId} {
      // Super Admin 可以讀取所有日誌
      allow read: if isSuperAdmin();
      // 系統可以建立日誌
      allow create: if request.auth != null;
      // 組織管理員可以讀取自己組織的日誌
      allow read: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 組織統計集合（Super Admin 專用）
    match /organizationStats/{statId} {
      // 只有 Super Admin 可以讀寫
      allow read, write: if isSuperAdmin();
    }
    
    // 欄位定義集合
    match /field_definitions/{defId} {
      // Super Admin 可以讀寫所有欄位定義
      allow read, write: if isSuperAdmin();
      
      // 已登入用戶可以讀取欄位定義
      allow read: if request.auth != null;
      
      // 組織管理員可以寫入自己組織的欄位定義
      allow write: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
        
      // 新建欄位定義（組織管理員）
      allow create: if request.auth != null && 
        getUserData().role == 'admin' &&
        request.resource.data.organizationId != null &&
        getUserData().organizationId == request.resource.data.organizationId &&
        request.resource.data.createdBy == request.auth.uid;
    }
    
    // 欄位關聯集合（用於跨資料庫關聯）
    match /field_relations/{relationId} {
      // Super Admin 可以讀寫所有關聯
      allow read, write: if isSuperAdmin();
      
      // 已登入用戶可以讀取（用於列表查詢，會在客戶端過濾）
      allow read: if request.auth != null && hasUserDoc();
      
      // 組織管理員可以管理自己組織的關聯
      allow write: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
        
      // 新建關聯（組織管理員）
      allow create: if request.auth != null && 
        getUserData().role == 'admin' &&
        request.resource.data.organizationId != null &&
        getUserData().organizationId == request.resource.data.organizationId &&
        request.resource.data.createdBy == request.auth.uid;
    }
    
    // 預設拒絕所有其他存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
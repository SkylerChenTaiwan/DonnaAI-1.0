rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 輔助函數：檢查是否為 Super Admin
    function isSuperAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'system-admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
        request.auth.token.role == 'system-admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'admin@donnaai-app.com'
      );
    }
    
    // 輔助函數：獲取用戶資料
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // 輔助函數：檢查是否為組織管理員
    function isOrgAdmin(orgId) {
      return request.auth != null && 
        getUserData().organizationId == orgId && 
        getUserData().role == 'admin';
    }
    
    // 輔助函數：檢查是否為組織成員
    function isOrgMember(orgId) {
      return request.auth != null && 
        getUserData().organizationId == orgId;
    }
    
    // 組織集合
    match /organizations/{orgId} {
      // Super Admin 可以讀寫所有組織
      allow read, write: if isSuperAdmin();
      // 組織成員可以讀取自己的組織
      allow read: if isOrgMember(orgId);
      // 組織管理員可以更新組織
      allow update: if isOrgAdmin(orgId);
    }
    
    // 用戶集合
    match /users/{userId} {
      // 用戶可以讀取自己的資料
      allow read: if request.auth != null && request.auth.uid == userId;
      // Super Admin 可以讀寫所有用戶
      allow read, write: if isSuperAdmin();
      // 組織管理員可以讀取同組織的用戶
      allow read: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
      // 組織管理員可以更新同組織的用戶（除了 role）
      allow update: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
    }
    
    // 團隊集合
    match /teams/{teamId} {
      // Super Admin 可以讀寫所有團隊
      allow read, write: if isSuperAdmin();
      // 團隊成員可以讀取
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.memberIds;
      // 組織管理員可以管理組織內的團隊
      allow read, write: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 客戶集合
    match /customers/{customerId} {
      // Super Admin 可以讀取（用於系統管理和統計）
      allow read: if isSuperAdmin();
      // 團隊成員可以讀寫
      allow read, write: if request.auth != null && 
        request.auth.uid in resource.data.teamMembers;
      // 創建者可以讀寫
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
      // 新增客戶
      allow create: if request.auth != null;
    }
    
    // 紀錄集合
    match /records/{recordId} {
      // Super Admin 可以讀取（用於系統監控）
      allow read: if isSuperAdmin();
      // 創建者可以讀寫
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
      // 團隊成員可以讀取
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.teamMembers;
      // 新增紀錄
      allow create: if request.auth != null;
    }
    
    // 任務集合
    match /tasks/{taskId} {
      // Super Admin 可以讀取（用於系統監控）
      allow read: if isSuperAdmin();
      // 指派對象可以讀寫
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.assignedTo;
      // 創建者可以讀寫
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
      // 新增任務
      allow create: if request.auth != null;
    }
    
    // 設定集合 - 用戶個人設定
    match /users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == userId || isSuperAdmin());
    }
    
    // 組織設定集合
    match /organizations/{orgId}/settings/{settingId} {
      allow read: if isOrgMember(orgId) || isSuperAdmin();
      allow write: if isOrgAdmin(orgId) || isSuperAdmin();
    }
    
    // AI 處理相關集合
    match /aiProcessing/{docId} {
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      allow read: if isSuperAdmin();
    }
    
    // 自定義欄位定義
    match /organizations/{orgId}/customFields/{fieldId} {
      allow read: if isOrgMember(orgId) || isSuperAdmin();
      allow write: if isOrgAdmin(orgId) || isSuperAdmin();
    }
    
    // 企業配置集合
    match /enterprise_configs/{configId} {
      // Super Admin 可以讀寫所有配置
      allow read, write: if isSuperAdmin();
      // 組織管理員可以讀取和更新自己組織的配置
      allow read: if request.auth != null && 
        getUserData().organizationId == resource.data.organizationId;
      allow update: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 系統統計（只有 Super Admin 可以存取）
    match /systemStats/{statId} {
      allow read: if isSuperAdmin();
      allow write: if false; // 只由 Cloud Functions 寫入
    }
    
    // 計費記錄集合
    match /billing_records/{recordId} {
      // Super Admin 可以讀寫所有計費記錄
      allow read, write: if isSuperAdmin();
      // 組織管理員可以讀取自己組織的計費記錄
      allow read: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
      // 組織成員可以讀取自己組織的計費記錄（唯讀）
      allow read: if request.auth != null && 
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 工具使用記錄集合
    match /tool_usage/{usageId} {
      // Super Admin 可以讀取所有使用記錄（用於系統分析）
      allow read: if isSuperAdmin();
      // 用戶可以建立自己的使用記錄
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      // 組織管理員可以讀取組織內的使用記錄
      allow read: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 工具使用每日統計集合
    match /tool_usage_daily_stats/{statId} {
      // Super Admin 可以讀寫所有統計
      allow read, write: if isSuperAdmin();
      // 系統可以建立和更新統計（由 Cloud Functions 或使用 service account）
      allow create, update: if request.auth != null;
      // 組織管理員可以讀取自己組織的統計
      allow read: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 自訂欄位配置集合
    match /custom_field_configs/{configId} {
      // Super Admin 可以讀寫所有配置
      allow read, write: if isSuperAdmin();
      // 組織管理員可以管理自己組織的配置
      allow read, write: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
      // 組織成員可以讀取自己組織的配置
      allow read: if request.auth != null && 
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 資料匯入日誌集合
    match /import_logs/{logId} {
      // Super Admin 可以讀取所有日誌
      allow read: if isSuperAdmin();
      // 系統可以建立日誌
      allow create: if request.auth != null;
      // 組織管理員可以讀取自己組織的日誌
      allow read: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 自訂欄位日誌集合
    match /custom_field_logs/{logId} {
      // Super Admin 可以讀取所有日誌
      allow read: if isSuperAdmin();
      // 系統可以建立日誌
      allow create: if request.auth != null;
      // 組織管理員可以讀取自己組織的日誌
      allow read: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 預設拒絕所有其他存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
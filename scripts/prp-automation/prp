#!/bin/bash

# PRP 自動化管理工具
# 提供便捷的 PRP 管理命令

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# 顏色定義
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 顯示使用說明
show_help() {
    echo -e "${BLUE}PRP 自動化管理工具${NC}"
    echo ""
    echo "使用方式:"
    echo "  ./prp <命令> [參數]"
    echo ""
    echo "可用命令:"
    echo -e "  ${GREEN}status${NC}           - 檢查所有 PRP 狀態"
    echo -e "  ${GREEN}complete <編號>${NC}   - 自動完成指定 PRP"
    echo -e "  ${GREEN}sync${NC}             - 同步 README 狀態"
    echo -e "  ${GREEN}list${NC}             - 列出所有 PRP"
    echo -e "  ${GREEN}ready${NC}            - 顯示準備完成的 PRP"
    echo -e "  ${GREEN}help${NC}             - 顯示此說明"
    echo ""
    echo "範例:"
    echo "  ./prp status                     # 檢查所有 PRP 狀態"
    echo "  ./prp complete 122               # 完成 PRP-122"
    echo "  ./prp complete 122 --force      # 強制完成 PRP-122"
    echo "  ./prp sync --commit              # 同步 README 並提交"
    echo "  ./prp ready                      # 顯示可以完成的 PRP"
}

# 檢查 Node.js
check_nodejs() {
    if ! command -v node &> /dev/null; then
        echo -e "${RED}❌ 錯誤: 需要安裝 Node.js${NC}"
        exit 1
    fi
}

# 檢查所有 PRP 狀態
check_status() {
    echo -e "${BLUE}🔍 檢查 PRP 狀態...${NC}"
    cd "$PROJECT_ROOT"
    node "$SCRIPT_DIR/check-prp-status.js"
}

# 完成指定 PRP
complete_prp() {
    if [ -z "$1" ]; then
        echo -e "${RED}❌ 錯誤: 請指定 PRP 編號${NC}"
        echo "使用方式: ./prp complete <編號>"
        exit 1
    fi
    
    echo -e "${BLUE}🚀 完成 PRP-$1...${NC}"
    cd "$PROJECT_ROOT"
    
    if [ "$2" == "--force" ]; then
        node "$SCRIPT_DIR/complete-prp.js" "$1" --force
    else
        node "$SCRIPT_DIR/complete-prp.js" "$1"
    fi
}

# 同步 README
sync_readme() {
    echo -e "${BLUE}🔄 同步 README...${NC}"
    cd "$PROJECT_ROOT"
    
    if [ "$1" == "--commit" ]; then
        node "$SCRIPT_DIR/sync-readme.js" --commit
    else
        node "$SCRIPT_DIR/sync-readme.js"
    fi
}

# 列出所有 PRP
list_prps() {
    echo -e "${BLUE}📋 PRP 列表:${NC}"
    cd "$PROJECT_ROOT/PRPs"
    
    echo ""
    echo -e "${GREEN}✅ 已完成:${NC}"
    ls -1 *v-*.md 2>/dev/null | sed 's/^/  /' || echo "  無"
    
    echo ""
    echo -e "${YELLOW}📋 未完成:${NC}"
    ls -1 [0-9]*-*.md 2>/dev/null | grep -v 'v-' | sed 's/^/  /' || echo "  無"
}

# 顯示準備完成的 PRP
show_ready() {
    echo -e "${BLUE}🚀 檢查準備完成的 PRP...${NC}"
    cd "$PROJECT_ROOT"
    
    # 建立臨時狀態檢查
    node -e "
        const { checkPrpCompletion } = require('$SCRIPT_DIR/complete-prp');
        const fs = require('fs').promises;
        const path = require('path');
        
        async function checkReady() {
            const prpDir = '$PROJECT_ROOT/PRPs';
            const files = await fs.readdir(prpDir);
            const prpFiles = files.filter(f => f.endsWith('.md') && f.match(/^\d+-.*\.md$/));
            
            console.log('\\n🚀 準備完成的 PRP:');
            let found = false;
            
            for (const file of prpFiles) {
                const prpNumber = file.match(/^(\d+)-/)[1];
                try {
                    const status = await checkPrpCompletion(path.join(prpDir, file));
                    if (status.isComplete) {
                        console.log(\`  ./prp complete \${prpNumber}  # \${file}\`);
                        found = true;
                    }
                } catch (e) {
                    // 忽略檢查錯誤
                }
            }
            
            if (!found) {
                console.log('  目前沒有準備完成的 PRP');
            }
        }
        
        checkReady().catch(console.error);
    "
}

# 主要邏輯
main() {
    check_nodejs
    
    case "$1" in
        "status")
            check_status
            ;;
        "complete")
            complete_prp "$2" "$3"
            ;;
        "sync")
            sync_readme "$2"
            ;;
        "list")
            list_prps
            ;;
        "ready")
            show_ready
            ;;
        "help"|"")
            show_help
            ;;
        *)
            echo -e "${RED}❌ 未知命令: $1${NC}"
            echo "使用 './prp help' 查看可用命令"
            exit 1
            ;;
    esac
}

# 執行主函數
main "$@"
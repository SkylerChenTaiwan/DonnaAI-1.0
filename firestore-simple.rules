rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 輔助函數：取得當前用戶資料
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // 輔助函數：檢查是否為系統管理員
    function isSystemAdmin() {
      return request.auth != null && 
        getUserData().role in ['super_admin', 'system-admin'];
    }
    
    // 組織集合 - 正確的權限控制
    match /organizations/{orgId} {
      // 只有 Super Admin 可以讀取所有組織
      allow read: if isSystemAdmin();
      // 組織成員只能讀取自己的組織
      allow read: if request.auth != null && 
        getUserData().organizationId == orgId;
      // 只有 Super Admin 可以寫入
      allow write: if isSystemAdmin();
    }
    
    // 用戶集合 - 正確的權限控制
    match /users/{userId} {
      // 用戶可以讀取自己的資料
      allow read: if request.auth != null && request.auth.uid == userId;
      // Super Admin 可以讀取所有用戶
      allow read: if isSystemAdmin();
      // 同組織的管理員可以讀取組織內用戶
      allow read: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
      
      // 只有 Super Admin 可以寫入
      allow write: if isSystemAdmin();
    }
    
    // 團隊集合 - 組織內可見
    match /teams/{teamId} {
      // Super Admin 可以讀寫所有團隊
      allow read, write: if isSystemAdmin();
      // 團隊成員可以讀取
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.memberIds;
      // 組織管理員可以管理
      allow write: if request.auth != null && 
        getUserData().role == 'admin' &&
        getUserData().organizationId == resource.data.organizationId;
    }
    
    // 客戶集合 - 組織隔離
    match /customers/{customerId} {
      // Super Admin 不應該看到客戶資料（業務隔離）
      allow read, write: if false;
    }
    
    // 任務集合 - 組織隔離
    match /tasks/{taskId} {
      // Super Admin 不應該看到任務資料（業務隔離）
      allow read, write: if false;
    }
    
    // 會議記錄集合 - 組織隔離
    match /records/{recordId} {
      // Super Admin 不應該看到會議記錄（業務隔離）
      allow read, write: if false;
    }
    
    // 設定集合
    match /organizations/{orgId}/settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 預設規則
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 暫時的開發規則 - 允許已登入用戶讀取
    // 警告：這只是臨時解決方案，生產環境請使用更嚴格的規則
    
    // 組織集合 - 允許所有已登入用戶讀取（臨時）
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'system-admin'];
    }
    
    // 用戶集合 - 基本權限
    match /users/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'system-admin']);
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'system-admin'];
    }
    
    // 團隊集合
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'system-admin', 'admin'];
    }
    
    // 客戶集合 - 組織成員可存取
    match /customers/{customerId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // 任務集合
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // 會議記錄集合
    match /records/{recordId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // 設定集合
    match /organizations/{orgId}/settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 預設規則
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
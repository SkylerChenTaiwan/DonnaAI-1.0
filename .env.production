# Firebase 生產環境配置
# 請從 Firebase Console 生產專案取得這些值：https://console.firebase.google.com
# 專案設定 > 您的應用程式 > Web 應用程式配置

# Firebase Web App 配置 - 生產環境
# TODO: 請從 Firebase Console 複製實際的值
EXPO_PUBLIC_FIREBASE_API_KEY=your_production_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=donnaai-production.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=donnaai-production
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=donnaai-production.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_production_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_production_app_id

# 環境設定
# 生產環境
EXPO_PUBLIC_ENV=production

# 生產模式除錯（關閉）
EXPO_PUBLIC_DEBUG=false